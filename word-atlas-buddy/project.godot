; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Node",
"class": "AudioDirector",
"language": "GDScript",
"path": "res://scripts/AudioDirector.gd"
}, {
"base": "Node",
"class": "ContentRepository",
"language": "GDScript",
"path": "res://scripts/ContentRepository.gd"
}, {
"base": "Node",
"class": "ProgressStore",
"language": "GDScript",
"path": "res://scripts/ProgressStore.gd"
}, {
"base": "Reference",
"class": "Srs",
"language": "GDScript",
"path": "res://scripts/Srs.gd"
}, {
"base": "Reference",
"class": "UIKit",
"language": "GDScript",
"path": "res://scripts/UIKit.gd"
} ]
_global_script_class_icons={
"AudioDirector": "",
"ContentRepository": "",
"ProgressStore": "",
"Srs": "",
"UIKit": ""
}

[application]

config/name="Word Atlas Buddy"
run/main_scene="res://scenes/Main.tscn"
config/use_hidden_project_data_directory=false
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/use_filter=false

[display]

window/size/width=640
window/size/height=480
window/size/test_width=640
window/size/test_height=480
window/stretch/mode="2d"
window/stretch/aspect="keep"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
2d/snapping/use_gpu_pixel_snap=true
vram_compression/import_etc=true
vram_compression/import_etc2=false
quality/2d/use_pixel_snap=true
